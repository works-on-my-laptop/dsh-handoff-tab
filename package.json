{
  "name": "dsh-handoff-tab",
  "version": "0.1.0",
  "description": "Session handoff tab for DeepSeek Harness: generates a paste-ready handoff prompt in a conversation view tab and stores it in the DSH storage domain.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "works-on-my-laptop",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "handoff",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/works-on-my-laptop/dsh-handoff-tab.git"
  },
  "homepage": "https://github.com/works-on-my-laptop/dsh-handoff-tab#readme",
  "bugs": {
    "url": "https://github.com/works-on-my-laptop/dsh-handoff-tab/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/client-smoke.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.1 <0.2.1 || >=0.2.1-rc.1 <0.2.2 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  }
}
